<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="recAgenda13Ds2.Views.Sobre" >
    <ScrollView>
        <VerticalStackLayout>

            <Label Margin="10"
            Text="Sobre"
            TextColor="{StaticResource Magenta}"
            FontFamily="Kalam"
            FontSize="50"
            HorizontalTextAlignment="Center"/>

            <!-- informações do projeto -->

            <Label Text="Agenda de Hospedagem"
                   TextColor="{StaticResource Magenta}"
                   FontSize="18"
                   HorizontalOptions="Center"
                   Margin="0,50,0,0"/>

            <Label Text="Desenvolvido por: Felipe de Oliveira"
                   FontSize="16"
                   HorizontalOptions="Center"
                   Margin="0,200,0,0"/>

            <Label Text="Versão: 1.0.0"
                   FontSize="14"
                   HorizontalOptions="Center"/>

            <Label Text="Ano: 2025"
                   FontSize="14"
                   HorizontalOptions="Center"/>
            <Button Text="Voltar" 
                    Padding="10"
                Clicked="Voltar_Sobre_Clicked"
                Margin="0,200,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>