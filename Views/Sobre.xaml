<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="recAgenda13Ds2.Views.Sobre" >
    <ScrollView>
        <VerticalStackLayout>

            <Label Margin="10"
            Text="Sobre"
            TextColor="{StaticResource Primary}"
            FontFamily="Kalam"
            FontSize="50"
            HorizontalTextAlignment="Center"/>

            <!-- informações do projeto -->

            <Label Text="Agenda de Hospedagem"
                   TextColor="{StaticResource Primary}"
                   FontSize="18"
                   HorizontalOptions="Center"/>

            <Label Text="Desenvolvido por: Felipe de Oliveira"
                   FontSize="16"
                   HorizontalOptions="Center"/>

            <Label Text="Versão: 1.0.0"
                   FontSize="14"
                   HorizontalOptions="Center"/>

            <Label Text="Ano: 2024"
                   FontSize="14"
                   HorizontalOptions="Center"/>
            <Button Text="Voltar"
            Margin="20"
            Clicked="Voltar_Sobre_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>